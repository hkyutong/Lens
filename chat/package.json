{
  "name": "lens-web",
  "version": "4.3.0",
  "private": true,
  "description": "Lens academic research workspace by YutoAI",
  "author": "YutoAI",
  "keywords": [
    "Lens",
    "academic-research",
    "research-workflow"
  ],
  "main": "electron/main.js",
  "scripts": {
    "start:h": "pnpm run -C service dev",
    "start:f": "vite",
    "all": "npm-run-all --parallel start:h start:f",
    "dev": "vite",
    "build-check": "npm run type-check && npm run build-only",
    "release-check": "npm run build-check && npm run verify:research-contract && npm run verify:release-candidate && npm run verify:brand-seo",
    "build-only": "vite build --mode=production",
    "preview": "vite preview",
    "build": "npm run build-only",
    "type-check": "vue-tsc --noEmit",
    "verify:brand-seo": "node ./scripts/verify_brand_seo.mjs",
    "verify:research-contract": "node ./scripts/verify_research_contract.mjs",
    "verify:release-candidate": "node ./scripts/verify_academic_release_candidate.mjs",
    "bootstrap": "pnpm install && pnpm run common:prepare",
    "common:cleanup": "rimraf node_modules && rimraf pnpm-lock.yaml",
    "format": "prettier --write '{src,scripts,config}/**/*.{vue,ts,tsx,js,jsx,css,scss,less,json,md,html,yml,yaml}' '*.{js,ts,json,md,yml}'",
    "electron": "electron .",
    "electron:dev": "cross-env ELECTRON_START_URL=http://localhost:9002 electron .",
    "electron:build": "pnpm run build && electron-builder",
    "electron:mac": "pnpm run build && npx electron-builder --mac --config.npmRebuild=false",
    "electron:mac-universal": "pnpm run build && npx electron-builder --mac --universal --config.npmRebuild=false",
    "electron:win": "pnpm run build && electron-builder --win",
    "electron:win-x64": "pnpm run build && electron-builder --win --x64",
    "electron:win-arm64": "pnpm run build && electron-builder --win --arm64",
    "electron:all": "pnpm run build && npx electron-builder --mac --universal --win --config.npmRebuild=false",
    "verify:katex-security": "node --test scripts/test-katex-security.cjs"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@icon-park/vue-next": "^1.4.2",
    "@opendocsg/pdf2md": "^0.2.9",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "@vueuse/core": "^13.9.0",
    "@vueuse/integrations": "^13.9.0",
    "@vueuse/motion": "^3.0.3",
    "clientjs": "^0.2.1",
    "codemirror": "^6.0.2",
    "file-saver": "^2.0.5",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "html2pdf.js": "0.14.0",
    "jschardet": "^3.1.4",
    "katex": "^0.18.2",
    "mammoth": "^1.13.0",
    "markdown-it": "^14.3.2",
    "markmap-common": "0.15.0",
    "markmap-lib": "0.15.0",
    "markmap-view": "0.15.0",
    "md-editor-v3": "6.5.4",
    "dompurify": "3.4.17",
    "mermaid": "^11.17.2",
    "npx": "^10.2.2",
    "pdfjs-dist": "6.2.108",
    "pinia": "^2.3.1",
    "pinyin-match": "^1.2.10",
    "pptxtojson": "^1.12.1",
    "qrcode": "^1.5.4",
    "turndown": "^7.2.4",
    "v-viewer": "3.0.21",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.14",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@iconify-json/material-symbols": "^1.2.95",
    "@iconify-json/ri": "^1.2.10",
    "@iconify/vue": "^4.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/crypto-js": "^4.2.2",
    "@types/katex": "^0.16.8",
    "@types/markdown-it": "14.1.2",
    "@types/markdown-table": "^3.0.0",
    "@types/node": "^18.19.130",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-vue": "5.2.4",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "cross-env": "^7.0.3",
    "crypto-js": "^4.2.0",
    "esbuild": "0.25.12",
    "less": "^4.9.1",
    "markdown-it-link-attributes": "^4.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.10",
    "rimraf": "^4.4.1",
    "tailwind-scrollbar": "^3.1.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~4.9.5",
    "vite": "6.4.4",
    "vue-tsc": "^1.8.27"
  },
  "license": "MIT",
  "packageManager": "pnpm@11.25.0"
}

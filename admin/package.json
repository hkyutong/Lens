{
  "type": "module",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm format && vue-tsc && vite build",
    "build:test": "pnpm format && vue-tsc && vite build --mode test",
    "serve": "http-server ./dist -o",
    "serve:test": "http-server ./dist-test -o",
    "svgo": "svgo -f src/assets/icons",
    "new": "plop",
    "generate:icons": "esno ./scripts/generate.icons.ts",
    "lint": "vue-tsc",
    "format": "prettier --write '{src,scripts,config}/**/*.{vue,ts,tsx,js,jsx,css,scss,less,json,md,html,yml,yaml}' '*.{js,ts,json,md,yml}'",
    "preinstall": "npx only-allow pnpm",
    "commit": "git cz",
    "release": "bumpp"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "@headlessui/vue": "^1.7.23",
    "@imengyu/vue3-context-menu": "1.4.8",
    "@vueuse/core": "13.1.0",
    "@vueuse/integrations": "13.1.0",
    "axios": "^1.20.0",
    "dayjs": "1.11.13",
    "echarts": "^5.6.0",
    "element-plus": "2.11.1",
    "eruda": "3.4.1",
    "floating-vue": "5.2.2",
    "hotkeys-js": "3.13.10",
    "less": "4.3.0",
    "lodash-es": "^4.18.1",
    "marked": "15.0.11",
    "md-editor-v3": "6.5.4",
    "mitt": "^3.0.1",
    "nprogress": "^0.2.0",
    "overlayscrollbars": "2.11.2",
    "overlayscrollbars-vue": "0.5.9",
    "path-browserify": "^1.0.1",
    "path-to-regexp": "^8.4.2",
    "pinia": "2.1.7",
    "prettier": "3.5.3",
    "resize-observer-polyfill": "^1.5.1",
    "uuid": "^11.1.1",
    "v-viewer": "3.0.21",
    "vconsole": "^3.15.1",
    "vue": "3.5.42",
    "vue-m-message": "^4.0.2",
    "vue-router": "4.5.1",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.542",
    "@iconify/vue": "^5.0.3",
    "@types/lodash-es": "^4.17.12",
    "@types/mockjs": "^1.0.10",
    "@types/node": "22.15.17",
    "@types/path-browserify": "^1.0.3",
    "@unocss/core": "66.1.1",
    "@unocss/preset-mini": "66.1.1",
    "@vitejs/plugin-legacy": "^6.1.1",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitejs/plugin-vue-jsx": "^4.2.0",
    "archiver": "^7.0.1",
    "autoprefixer": "^10.6.1",
    "boxen": "^8.0.1",
    "bumpp": "^10.4.1",
    "esno": "^4.8.0",
    "fs-extra": "^11.4.1",
    "http-server": "^14.1.1",
    "inquirer": "^12.11.1",
    "msw": "^2.15.0",
    "picocolors": "^1.1.1",
    "plop": "^4.0.5",
    "sass": "^1.105.1",
    "svgo": "^3.3.5",
    "terser": "^5.51.2",
    "typescript": "5.8.3",
    "unocss": "66.1.1",
    "unplugin-auto-import": "^19.3.0",
    "unplugin-turbo-console": "^2.3.3",

    "vite-plugin-vue-devtools": "^7.7.10",
    "vite-plugin-vue-meta-layouts": "^0.5.1",
    "vue-tsc": "2.2.10"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "resolutions": {
    "braces": ">=3.0.3",
    "postcss": ">=8.4.31",
    "micromatch": ">=4.0.8",
    "esbuild": ">=0.25.0"
  },
  "packageManager": "pnpm@11.25.0"
}

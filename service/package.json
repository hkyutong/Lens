{
  "name": "yutoscholar-service",
  "version": "4.3.0",
  "description": "",
  "author": "vastxie",
  "private": true,
  "license": "Apache-2.0",
  "bin": "./dist/main.js",
  "scripts": {
    "start": "pm2 start pm2.conf.json",
    "build": "nest build && node scripts/lens_build_entity_metadata.cjs",
    "build:test": "nest build",
    "format": "prettier --write 'src/**/*.{vue,ts,tsx,js,jsx,css,scss,less}'",
    "guard:playwright": "node ./scripts/guard_playwright_policy.mjs --scan-only",
    "generate:long-chat-fixture": "node ./scripts/generate_long_chat_fixture.mjs",
    "test:playwright": "node ./scripts/run_playwright_local.mjs",
    "test:live-smoke": "NODE_PATH=node_modules/.pnpm/node_modules node scripts/verify-lens-live-smoke.cjs",
    "test:academic-real-gate": "node ./scripts/academic_real_gate.mjs",
    "test:academic-real-gate-contract": "node ./scripts/academic_real_gate_contract.mjs",
    "test:academic-controlled-write": "node ./scripts/academic_controlled_write_gate.mjs",
    "test:academic-controlled-write-contract": "node ./scripts/academic_controlled_write_gate_contract.mjs",
    "test:legacy-removal-gate": "node ./scripts/verify_legacy_removal_gate_contract.mjs",
    "verify:legacy-removal-ready": "node ./scripts/verify_legacy_removal_ready.mjs",
    "test:academic-engine-contract": "node ./scripts/academic_engine_contract_gate.mjs",
    "test:static-release-contract": "node ./scripts/static_release_contract_gate.mjs",
    "rollback:chat-static": "node ./scripts/sync_static_release.mjs --rollback --target ./public/chat --backup ./.release-backups/chat-latest",
    "test:chrome-long-chat": "pnpm run generate:long-chat-fixture && CHAT_BASE_URL=http://127.0.0.1:9003 pnpm run test:playwright -- playwright/long_chat_pressure.spec.cjs",
    "test:regression": "pnpm run test:playwright",
    "test:release-gate-local": "node ./scripts/prod_gate_suite.mjs && node ./scripts/full_smoke_test.mjs && pnpm run test:chrome-long-chat",
    "encrypt": "node ./encrypt.js",
    "start:daemon": "pm2 start pm2.conf.json --no-daemon",
    "dev": "nest start --watch --preserveWatchOutput",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "pkg:win": "pkg . -t node16-win-x64 -o app-win --debug",
    "pkg:mac": "pkg . -t node16-mac-x64 -o app-mac --debug",
    "pkg:linux": "pkg . -t node16-linux-x64 -o app-linux --debug",
    "test:local-credentials-contract": "node --test scripts/local_test_credentials.test.cjs",
    "test:local-acceptance-contract": "NODE_PATH=node_modules/.pnpm/node_modules node --test scripts/local_test_credentials.test.cjs scripts/live_research_challenge.test.cjs scripts/live_smoke_browser_contract.test.cjs scripts/academic_write_identity.test.mjs scripts/academic_core_semantics.test.cjs scripts/academic_mindmap_render.test.cjs scripts/academic_mermaid_recovery.test.cjs scripts/academic_config_access.test.cjs scripts/academic_upload_controller.test.cjs",
    "test:academic-core-live": "node scripts/verify_academic_core_live.cjs"
  },
  "dependencies": {
    "@alicloud/pop-core": "^1.8.0",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@google/genai": "^0.10.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "@nestjs/websockets": "^10.4.22",
    "@types/raw-body": "^2.3.0",
    "abort-controller": "^3.0.0",
    "ali-oss": "^6.23.0",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "compression": "^1.8.2",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "cross-fetch": "3.1.6",
    "dayjs": "^1.11.23",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.3",
    "fast-xml-parser": "^5.11.2",
    "form-data": "^4.0.6",
    "gpt-tokenizer": "^2.9.0",
    "guid-typescript": "^1.0.9",
    "https-proxy-agent": "7.0.2",
    "iconv-lite": "^0.6.3",
    "ioredis": "^5.11.1",
    "jschardet": "^3.1.4",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mammoth": "^1.13.0",
    "markdown-table": "^3.0.4",
    "mime-types": "^2.1.35",
    "mysql2": "^3.24.6",
    "node-cron": "^3.0.3",
    "node-machine-id": "^1.1.12",
    "nodemailer": "10.0.9",
    "openai": "^4.104.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "path-to-regexp": "^1.9.0",
    "pdf-parse": "^1.1.4",
    "pptxtojson": "^1.12.1",
    "raw-body": "^3.0.2",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "stream-to-buffer": "^0.1.0",
    "tough-cookie": "^4.1.4",
    "typeorm": "^0.3.31",
    "uuid": "^9.0.1",
    "wechatpay-node-v3": "^2.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^4.17.25",
    "@types/node": "18.11.18",
    "fs-extra": "^11.4.1",
    "javascript-obfuscator": "^4.2.2",
    "jest": "29.3.1",
    "pm2": "^6.0.14",
    "prettier": "^2.8.8",
    "ts-jest": "29.0.3",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/$1",
      "^src/(.*)$": "<rootDir>/$1"
    },
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@11.25.0"
}
